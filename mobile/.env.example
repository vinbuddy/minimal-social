# Copy to .env.local. In development the app finds the API on the machine running Metro (port 5000),
# so this is only needed to point at another server, e.g. https://api.example.com
EXPO_PUBLIC_API_BASE_URL=
# EXPO_PUBLIC_API_PORT=5000
# The web client (e.g. https://minimal-social.vercel.app), for "Copy link" on posts
EXPO_PUBLIC_WEB_URL=

# Google Sign-In (development build only, not Expo Go). Leave empty to hide the Google button.
# Web client ID = the server's GOOGLE_CLIENT_ID. The iOS URL scheme is the iOS client ID reversed:
# com.googleusercontent.apps.<id>
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
