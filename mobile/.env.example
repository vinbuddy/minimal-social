# Copy to .env.local. Use your machine's LAN IP on a physical device, http://10.0.2.2:5000 on the Android emulator.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000

# Google Sign-In (development build only, not Expo Go). Leave empty to hide the Google button.
# Web client ID = the server's GOOGLE_CLIENT_ID. The iOS URL scheme is the iOS client ID reversed:
# com.googleusercontent.apps.<id>
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
